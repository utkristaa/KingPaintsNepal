# Environment Variables Template
# Public variables exposed to frontend must start with VITE_
VITE_SITE_URL=https://kingpaintsnepal.com.np
VITE_ENABLE_ANALYTICS=false

# Server-only values for Vercel Functions and Prisma.
DATABASE_URL=postgresql://user:password@host:5432/king_paints
# Optional. If omitted, the dashboard password is used for admin API requests.
# ADMIN_API_TOKEN=replace-with-a-long-random-token

# Keep private keys and secret credentials exclusively on server-side environments!
# DO NOT put database passwords, admin tokens, or private API keys in client-side code.

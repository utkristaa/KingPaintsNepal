generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  PENDING
  REVIEWED
  CONTACTED
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  businessName String?
  email        String
  phone        String
  location     String
  message      String
  status       InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}
